{
  "name": "cincinnati-hotel-chatbot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "e2e": "turbo run e2e --filter=e2e",
    "e2e:real": "turbo run e2e:real --filter=e2e",
    "n8n:import": "pnpm --filter n8n run import",
    "sample:pdf": "tsx docs/sample/generate-sample-pdf.ts"
  },
  "devDependencies": {
    "@types/pdfkit": "^0.17.7",
    "pdfkit": "^0.20.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "turbo": "^2.11.10"
  }
}
