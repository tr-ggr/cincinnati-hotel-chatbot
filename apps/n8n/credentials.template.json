[
  {
    "id": "cred-openai",
    "name": "OpenAI account",
    "type": "openAiApi",
    "data": {
      "apiKey": "${OPENAI_API_KEY}",
      "url": "https://api.openai.com/v1"
    }
  },
  {
    "id": "cred-postgres",
    "name": "Hotel Postgres",
    "type": "postgres",
    "data": {
      "host": "postgres",
      "port": 5432,
      "database": "${POSTGRES_DB}",
      "user": "${POSTGRES_USER}",
      "password": "${POSTGRES_PASSWORD}",
      "ssl": "disable",
      "allowUnauthorizedCerts": false,
      "sshTunnel": false
    }
  },
  {
    "id": "cred-webhook-secret",
    "name": "Hotel Webhook Secret",
    "type": "httpHeaderAuth",
    "data": {
      "name": "x-hotel-secret",
      "value": "${N8N_WEBHOOK_SECRET}"
    }
  },
  {
    "id": "cred-resend",
    "name": "Resend",
    "type": "httpHeaderAuth",
    "data": {
      "name": "Authorization",
      "value": "Bearer ${RESEND_API_KEY}"
    }
  }
]
